## Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

## Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pingpang

## Redis (optional in dev — falls back to in-memory store)
REDIS_URL=redis://localhost:6379

## Auth (rotate AUTH_TOKEN_SECRET and ADMIN_TOKEN per environment)
ALLOW_DEV_LOGIN=true                       # MUST be false in production
AUTH_TOKEN_SECRET=pingpang-dev-session-secret
AUTH_TOKEN_TTL_SECONDS=604800              # 7 days
ADMIN_TOKEN=dev-admin-token

## SMS provider (production only — log fallback is rejected in NODE_ENV=production)
# SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=Pingpang
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# ALIYUN_SMS_REGION=cn-hangzhou

## CORS allowlist (comma separated). Empty = permissive (dev only).
# CORS_ALLOW_ORIGIN=https://app.pingpang.example.com,https://admin.pingpang.example.com

## Observability (production only)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

## Mobile / admin client base URLs (consumed at build time)
VITE_API_BASE_URL=
VITE_API_BASE_URL_H5=http://localhost:3000
VITE_API_BASE_URL_MP_WEIXIN=http://127.0.0.1:3000
