generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OptionPresetKind {
  LEVEL
  PLAYER_COUNT
}

model User {
  id               String                  @id @default(cuid())
  phone            String?                 @unique
  /// Lowercased email address. Used as the H5 login identifier when SMS
  /// isn't available — kept independent of `phone` so a user can have
  /// either or both depending on which client they signed up from.
  email            String?                 @unique
  /// bcrypt hash of the user's password. Null for accounts created via
  /// WeChat / phone OTP that never set a password.
  passwordHash     String?
  wechatOpenId     String?                 @unique
  wechatUnionId    String?                 @unique
  nickname         String
  city             String
  level            String
  avatarUrl        String?
  creditScore      Int                     @default(100)
  createdAt        DateTime                @default(now())
  hostedMatches    Match[]                 @relation("HostedMatches")
  threadMembership ChatThreadParticipant[]
}

model Venue {
  id                 String                  @id @default(cuid())
  name               String
  city               String
  district           String?
  /// Fallback "default" distance shown when the caller does not pass a
  /// location. Kept for backwards compatibility — real distance is computed
  /// on demand via Haversine when lat/lng is provided.
  distanceKm         Float
  /// GCJ-02 (mars) coordinates. Mainland China legal requirement; matches
  /// what WeChat's getLocation({ type: 'gcj02' }) and Tencent Maps return,
  /// so the value can be passed straight to <map> without a transform.
  latitude           Float?
  longitude          Float?
  /// Full human-readable street address. Shown on the match detail card and
  /// passed to wx.openLocation for native navigation.
  address            String?
  /// AMap POI id. Set when this Venue row was upserted from a user-selected
  /// search result so the same physical place doesn't get duplicated across
  /// users. Null for hand-seeded venues.
  amapPoiId          String?                 @unique
  sortOrder          Int                     @default(0)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  courts             VenueCourt[]
  availabilitySlots  VenueAvailabilitySlot[]
  matches            Match[]

  @@index([isActive, sortOrder])
}

model VenueCourt {
  id         String   @id @default(cuid())
  venueId    String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@index([venueId, isActive, sortOrder])
}

model VenueAvailabilitySlot {
  id         String   @id @default(cuid())
  venueId    String
  label      String
  startTime  Int
  endTime    Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@index([venueId, isActive, sortOrder])
}

model OptionPreset {
  id         String            @id @default(cuid())
  kind       OptionPresetKind
  value      String
  label      String
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([kind, isActive, sortOrder])
}

model Match {
  id              String             @id @default(cuid())
  title           String
  venueName       String
  venueId         String?
  courtId         String?
  slotId          String?
  startTime       DateTime
  city            String
  level           String
  maxPlayers      Int
  openSlots       Int
  status          String             @default("open")
  checkInCode     String?
  coverUrl        String?
  hostUserId      String
  hostCreditScore Int
  distanceKm      Float
  matchRate       Int
  createdAt       DateTime           @default(now())
  hostUser        User               @relation("HostedMatches", fields: [hostUserId], references: [id], onDelete: Cascade)
  venue           Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  court           VenueCourt?        @relation(fields: [courtId], references: [id], onDelete: SetNull)
  slot            VenueAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  applications    MatchApplication[]
  thread          ChatThread?

  @@index([venueId])
  @@index([courtId])
  @@index([slotId])
}

model MatchApplication {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  status    String
  decisionReason String?
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Review {
  id          String   @id @default(cuid())
  matchId     String
  reviewerId  String
  revieweeId  String
  score       Int
  tags        String[]
  anonymous   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([matchId, reviewerId, revieweeId])
  @@index([matchId])
  @@index([revieweeId])
}

model ChatThread {
  id                   String                  @id @default(cuid())
  matchId              String                  @unique
  title                String
  venueName            String
  scheduledAt          DateTime
  hostUserId           String
  status               String                  @default("active")
  latestMessagePreview String
  latestMessageAt      DateTime
  lastMessageSenderId  String?
  lastMessageSenderName String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  match                Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants         ChatThreadParticipant[]
  messages             Message[]
}

model ChatThreadParticipant {
  id           String     @id @default(cuid())
  threadId     String
  userId       String
  role         String
  joinedAt     DateTime   @default(now())
  lastReadAt   DateTime?
  checkedInAt  DateTime?
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, threadId])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetUserId String
  matchId      String?
  reason       String
  status       String   @default("open")
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([status, createdAt])
}

model Message {
  id         String      @id @default(cuid())
  userId     String
  kind       String
  title      String
  content    String
  senderId   String?
  senderName String?
  isRead     Boolean     @default(false)
  status     String?
  matchId    String?
  threadId   String?
  createdAt  DateTime    @default(now())
  thread     ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, isRead])
  @@index([userId, matchId, kind])
  @@index([userId, threadId, kind])
}
